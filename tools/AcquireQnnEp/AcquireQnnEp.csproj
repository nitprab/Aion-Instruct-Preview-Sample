<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>AionInstructPreview.Tools.AcquireQnnEp</RootNamespace>
    <AssemblyName>AcquireQnnEp</AssemblyName>

    <Platforms>ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">ARM64</Platform>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>

    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>

    <!-- The exact 1.8 packages are downloadable but are not yet visible in NuGet's v3 registration index. -->
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);https://www.nuget.org/api/v2/</RestoreAdditionalProjectSources>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="1.8.2197" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260508005" />
  </ItemGroup>

</Project>
